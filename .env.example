# Supabase configuration for backend/auth storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-service-role-or-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key (recommended for server admin operations)
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key (not supported for server-side auth/admin operations)
# For client-side code only (never use server-only secrets here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

JWT_SECRET=replace-with-a-long-random-secret
# Login/API token lifetime. The default in server.js is 30 days.
JWT_EXPIRES_IN=30d

# Optional: forward incoming WhatsApp messages to your ERP/CRM webhook.
# The signature is HMAC-SHA256 of the raw JSON body, in X-Webhook-Signature.
INCOMING_WEBHOOK_URL=https://erp.example.com/api/webhooks/whatsapp
INCOMING_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Legacy MongoDB settings removed after Supabase migration
#MONGO_URI=mongodb://127.0.0.1:27017/whatsapp_messaging_bot
